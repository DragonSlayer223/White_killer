% =========================================================================
% Stewart Platform Rotary IK - Rigorously Corrected Rotation Axis
% =========================================================================
clear; clc; close all;

%% 1. PHYSICAL DIMENSIONS
R_base = 8.36;         % Distance from center of base to motor shafts (cm)
R_platform = 8.1;      % Distance from center of platform to joint pairs (cm)[cite: 1]
L_short = 5.1;         % Length of motor arm / servo horn (cm)[cite: 1]
L_long = 17.1;         % Length of connecting rod / long arm (cm)[cite: 1]
pair_spacing = 0.66;   % Spacing between paired joints (6.6 mm = 0.66 cm)[cite: 1]
Z_home = 12.4;         % Measured baseline vertical height (cm)
Platform_Diameter = 17.8; % Platform total diameter (cm)

%% 2. MOTOR LIMIT & OFFSET CONFIGURATION
physical_home_offset_deg = 68; 
max_travel_from_equilibrium = 68;

%% 3. DEFINE DESIRED POSE (6-DOF: Position + Tilt)
tilt_deg = 15;         % Total tilt angle in degrees
azimuth_deg = 68;      % Direction of the highest point of the platform (degrees)

% --- NEW: Allow independent X and Y translation (in cm) ---
X_offset = 0.0;        % Slide platform along X axis
Y_offset = 0.0;        % Slide platform along Y axis
Z_current = Z_home;    % Baseline height (can also be dynamically changed!)

theta_tilt = tilt_deg * pi / 180;
phi_azimuth = azimuth_deg * pi / 180;

%% 4. RIGID FIRST-PRINCIPLES ROTATION & TRANSLATION VECTORS
axis_x = sin(phi_azimuth);
axis_y = -cos(phi_azimuth);
rot_axis = [axis_x; axis_y; 0];

K = [0, -rot_axis(3), rot_axis(2);
     rot_axis(3), 0, -rot_axis(1);
     -rot_axis(2), rot_axis(1), 0];
 
R_tilt = eye(3) + sin(theta_tilt)*K + (1 - cos(theta_tilt))*(K^2);

% --- Pass the full 3D translation vector ---
T_tilt = [X_offset; Y_offset; Z_current];

%% 4. RIGID FIRST-PRINCIPLES ROTATION AXIS (Corrected Sign)
% This ensures positive theta elevates the platform in the direction of phi_azimuth
axis_x = sin(phi_azimuth);
axis_y = -cos(phi_azimuth);
rot_axis = [axis_x; axis_y; 0];

K = [0, -rot_axis(3), rot_axis(2);
     rot_axis(3), 0, -rot_axis(1);
     -rot_axis(2), rot_axis(1), 0];
 
R_tilt = eye(3) + sin(theta_tilt)*K + (1 - cos(theta_tilt))*(K^2);
T_tilt = [0; 0; Z_home];

%% 5. SETUP BASE & PLATFORM GEOMETRY
face_angles = [0, 120, 240] * pi / 180; 
half_pair = pair_spacing / 2;

% Base Motor Shaft Positions (6 total)
Base_Points = zeros(3, 6);
idx = 1;
for i = 1:3
    theta = face_angles(i);
    nx = cos(theta); ny = sin(theta);
    tx = -sin(theta); ty = cos(theta);
    
    Base_Points(:, idx)   = [R_base*nx + half_pair*tx; R_base*ny + half_pair*ty; 0];
    Base_Points(:, idx+1) = [R_base*nx - half_pair*tx; R_base*ny - half_pair*ty; 0];
    idx = idx + 2;
end

% Platform Joint Local Positions
Platform_Local = zeros(3, 6);
idx = 1;
for i = 1:3
    theta = face_angles(i);
    nx = cos(theta); ny = sin(theta);
    tx = -sin(theta); ty = cos(theta);
    
    Platform_Local(:, idx)   = [R_platform*nx + half_pair*tx; R_platform*ny + half_pair*ty; 0];
    Platform_Local(:, idx+1) = [R_platform*nx - half_pair*tx; R_platform*ny - half_pair*ty; 0];
    idx = idx + 2;
end

%% 6. INVERSE KINEMATICS SOLVER
calc_ik = @(R_mat, T_vec) get_motor_angles(R_mat, T_vec, Base_Points, Platform_Local, face_angles, L_short, L_long);

% --- Home State ---
R_home = eye(3);
T_home = [0; 0; Z_home];
home_angles_rad = calc_ik(R_home, T_home);

% --- Tilted State ---
tilted_angles_rad = calc_ik(R_tilt, T_tilt);

% --- Compute Deltas & Physical Motor Positions ---
delta_angles_deg = (tilted_angles_rad - home_angles_rad) * 180 / pi;
physical_motor_angles_deg = physical_home_offset_deg + delta_angles_deg;

%% 7. DISPLAY RESULTS & SAFETY CHECK
disp('=== PHYSICAL MOTOR COMMANDS (RIGOROUSLY CORRECTED) ===');
for i = 1:6
    fprintf('Motor %d: Delta = %+.2f° | Final Physical Position = %.2f°\n', ...
        i, delta_angles_deg(i), physical_motor_angles_deg(i));
    
    if physical_motor_angles_deg(i) < 0 || physical_motor_angles_deg(i) > (2 * max_travel_from_equilibrium)
        warning('--> Motor %d is hitting a physical limit switch!', i);
    end
end

%% 8. 3D VISUALIZATION WITH MOTOR LABELS & PEAK INDICATOR
figure('Name', 'Stewart Platform - Rigorous IK Model', 'Color', 'w');
hold on; grid on; axis equal; view(3);

% Plot Base Motor Shafts & Labels
scatter3(Base_Points(1,:), Base_Points(2,:), Base_Points(3,:), 80, 'r', 'filled');
for i = 1:6
    text(Base_Points(1,i)+0.3, Base_Points(2,i)+0.3, Base_Points(3,i)+0.5, ...
        sprintf('M%d', i), 'FontSize', 10, 'FontWeight', 'bold', 'Color', 'r');
end

% Plot Tilted Platform Joints
Platform_Global = R_tilt * Platform_Local + T_tilt;
scatter3(Platform_Global(1,:), Platform_Global(2,:), Platform_Global(3,:), 80, 'b', 'filled');

% Draw Connecting Rods
for i = 1:6
    plot3([Base_Points(1,i), Platform_Global(1,i)], ...
          [Base_Points(2,i), Platform_Global(2,i)], ...
          [Base_Points(3,i), Platform_Global(3,i)], 'g-', 'LineWidth', 2);
end

% Plot Platform Surface
r_plate = Platform_Diameter / 2;
theta_circle = linspace(0, 2*pi, 100);
plate_local = [r_plate * cos(theta_circle); r_plate * sin(theta_circle); zeros(1, length(theta_circle))];
plate_global = R_tilt * plate_local + T_tilt;
fill3(plate_global(1,:), plate_global(2,:), plate_global(3,:), 'c', ...
      'FaceAlpha', 0.25, 'EdgeColor', 'b', 'LineWidth', 1.5);

% --- PEAK AZIMUTH INDICATOR VECTOR ---
peak_local_dir = [r_plate * cos(phi_azimuth); r_plate * sin(phi_azimuth); 0];
peak_global = R_tilt * peak_local_dir + T_tilt;
center_global = T_tilt;

quiver3(center_global(1), center_global(2), center_global(3), ...
        peak_global(1)-center_global(1), peak_global(2)-center_global(2), peak_global(3)-center_global(3), ...
        0, 'm', 'LineWidth', 3, 'MaxHeadSize', 0.5);
text(peak_global(1), peak_global(2), peak_global(3)+0.8, 'PEAK (High Side)', ...
     'FontSize', 10, 'FontWeight', 'bold', 'Color', 'm');

xlabel('X (cm)'); ylabel('Y (cm)'); zlabel('Z (cm)');
title(sprintf('Rigorously Corrected Model | Tilt: %d° at Azimuth: %d°', tilt_deg, azimuth_deg));
legend('Base Motors', 'Platform Joints', 'Connecting Links', 'Top Platform', 'Peak Direction', 'Location', 'northeast');


%% --- LOCAL IK FUNCTION DEFINITION ---
function angles_rad = get_motor_angles(R, T, Base_Points, Platform_Local, face_angles, L_short, L_long)
    angles_rad = zeros(1, 6);
    Platform_Global = R * Platform_Local + T;
    
    for i = 1:6
        P = Platform_Global(:, i);
        B = Base_Points(:, i);
        
        face_idx = floor((i-1)/2) + 1;
        face_theta = face_angles(face_idx);
        
        BP = P - B;
        z_rel = BP(3);
        
        % Radial swing plane projection
        nx = cos(face_theta);
        ny = sin(face_theta);
        xy_proj = dot(BP, [nx; ny; 0]);
        
        r_rel = sqrt(xy_proj^2 + z_rel^2);
        
        tolerance = 1.0; 
        if r_rel > (L_short + L_long + tolerance) || r_rel < (abs(L_long - L_short) - tolerance)
            r_rel = max(abs(L_long - L_short), min(L_short + L_long, r_rel));
        end
        
        cos_beta = (L_short^2 + r_rel^2 - L_long^2) / (2 * L_short * r_rel);
        cos_beta = max(-1, min(1, cos_beta));
        beta = acos(cos_beta);
        
        gamma = atan2(z_rel, xy_proj);
        angles_rad(i) = gamma - beta; 
    end
end
