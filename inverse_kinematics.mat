% =========================================================================
% STEWART PLATFORM IK WITH AUTOMATIC Z-LIFT OPTIMIZATION
% Automatically finds the lowest safe platform height for high tilts.
% =========================================================================
clear; clc; close all;

%% 1. PHYSICAL DIMENSIONS & LIMIT CONSTRAINTS
L_short = 5.1;          % Servo horn length (cm)[cite: 2]
L_long = 17.1;          % Connecting rod length (cm)[cite: 2]
r_base = 8.36;          % Base motor radius (cm)
r_plat = 8.13;          % Platform anchor radius (cm)[cite: 2]
Z_home = 12.13;         % Equilibrium baseline height (cm)[cite: 2]

% Motor Physical Limits (Measured relative to Vertical = 0°)
MIN_ARM_ANGLE_VERT_DEG = 18.0;  % Limit switch floor (0° horizontal)
MAX_ARM_ANGLE_VERT_DEG = 136.0; % Upper mechanical travel boundary

%% 2. DEFINE DESIRED POSE (6-DOF: Position + Tilt)
tilt_deg = 20;          % Try a massive 20° tilt!
azimuth_deg = 68;       % Direction of highest point on platform (degrees)
X_offset = 0.0;
Y_offset = 0.0;

theta_tilt = deg2rad(tilt_deg);
phi_azimuth = deg2rad(azimuth_deg);

%% 3. RIGID ROTATION MATRIX (Fixed for given tilt & azimuth)
axis_x = sin(phi_azimuth);
axis_y = -cos(phi_azimuth);
rot_axis = [axis_x; axis_y; 0];
K = [0, -rot_axis(3), rot_axis(2);
     rot_axis(3), 0, -rot_axis(1);
     -rot_axis(2), rot_axis(1), 0];
 
R_tilt = eye(3) + sin(theta_tilt)*K + (1 - cos(theta_tilt))*(K^2);

%% 4. GEOMETRY SETUP
face_centers_deg = [0, 120, 240];
base_offsets_deg  = [-14.37, 14.37]; 
plat_offsets_deg  = [-2.33,   2.33];  

Base_Points = zeros(3, 6);
Platform_Local = zeros(3, 6);
base_angles_deg = zeros(1, 6);

idx = 1;
for f = 1:3
    center = face_centers_deg(f);
    for p = 1:2
        b_ang = center + base_offsets_deg(p);
        base_angles_deg(idx) = b_ang;
        theta_b = deg2rad(b_ang);
        Base_Points(:, idx) = [r_base * cos(theta_b); r_base * sin(theta_b); 0.0];
        
        p_ang = center + plat_offsets_deg(p);
        theta_p = deg2rad(p_ang);
        Platform_Local(:, idx) = [r_plat * cos(theta_p); r_plat * sin(theta_p); 0.0];
        idx = idx + 1;
    end
end

%% 5. AUTOMATIC Z-LIFT SEARCH ALGORITHM
% Scans upward from Z_home to find the minimum height where all motors are safe
Z_optimized = Z_home;
found_valid_pose = false;

for z_test = Z_home : 0.05 : (Z_home + 15.0)
    T_test = [X_offset; Y_offset; z_test];
    [angles_test, valid_test] = evaluate_ik(R_tilt, T_test, Base_Points, Platform_Local, base_angles_deg, L_short, L_long, MIN_ARM_ANGLE_VERT_DEG, MAX_ARM_ANGLE_VERT_DEG);
    
    if valid_test
        Z_optimized = z_test;
        found_valid_pose = true;
        break;
    end
end

if ~found_valid_pose
    error('Requested tilt is too extreme; exceeds maximum workspace limits even with Z-lift!');
else
    fprintf('=== AUTO-LIFT SUCCESS ===\n');
    fprintf('Base Home Height: %.2f cm\n', Z_home);
    fprintf('Optimized Lift Height for %d° Tilt: %.2f cm (Lifted by +%.2f cm)\n\n', ...
        tilt_deg, Z_optimized, Z_optimized - Z_home);
end

% Compute final angles and positions using optimized Z
T_tilt = [X_offset; Y_offset; Z_optimized];
[arm_angles_vert_deg, ~] = evaluate_ik(R_tilt, T_tilt, Base_Points, Platform_Local, base_angles_deg, L_short, L_long, MIN_ARM_ANGLE_VERT_DEG, MAX_ARM_ANGLE_VERT_DEG);

%% 6. DISPLAY FINAL MOTOR VERIFICATION
disp('=== FINAL MOTOR ANGLES (WITH AUTO-LIFT) ===');
for i = 1:6
    fprintf('Motor %d: %.2f° --> [SAFE]\n', i, arm_angles_vert_deg(i) - 90);
end

%% 7. 3D VISUALIZATION
figure('Name', 'Stewart Platform - Auto-Lift Optimized', 'Color', 'w');
hold on; grid on; axis equal; view(3);

scatter3(Base_Points(1,:), Base_Points(2,:), Base_Points(3,:), 80, 'r', 'filled');
for i = 1:6
    text(Base_Points(1,i)+0.2, Base_Points(2,i)+0.2, Base_Points(3,i)+0.3, ...
        sprintf('M%d', i), 'FontSize', 10, 'FontWeight', 'bold', 'Color', 'r');
end

Platform_Global = R_tilt * Platform_Local + T_tilt;
scatter3(Platform_Global(1,:), Platform_Global(2,:), Platform_Global(3,:), 80, 'b', 'filled');

Elbow_Points = zeros(3, 6);
for i = 1:6
    face_idx = floor((i-1)/2) + 1;
    face_theta = deg2rad(face_centers_deg(face_idx));
    
    tx = -sin(face_theta);
    ty = cos(face_theta);
    
    is_right_motor = mod(i, 2) == 0;
    side_sign = is_right_motor * 2 - 1; 
    
    theta_vert_rad = deg2rad(arm_angles_vert_deg(i));
    B = Base_Points(:, i);
    P = Platform_Global(:, i);
    
    E = B + L_short * sin(theta_vert_rad) * (side_sign * [tx; ty; 0]) + L_short * cos(theta_vert_rad) * [0; 0; 1];
    Elbow_Points(:, i) = E;
    
    plot3([B(1), E(1)], [B(2), E(2)], [B(3), E(3)], 'Color', [1, 0.5, 0], 'LineWidth', 3);
    plot3([E(1), P(1)], [E(2), P(2)], [E(3), P(3)], 'g-', 'LineWidth', 2);
end

scatter3(Elbow_Points(1,:), Elbow_Points(2,:), Elbow_Points(3,:), 50, [1, 0.5, 0], 'filled');

theta_circle = linspace(0, 2*pi, 100);
plate_local = [r_plat * cos(theta_circle); r_plat * sin(theta_circle); zeros(1, length(theta_circle))];
plate_global = R_tilt * plate_local + T_tilt;
fill3(plate_global(1,:), plate_global(2,:), plate_global(3,:), 'c', ...
      'FaceAlpha', 0.25, 'EdgeColor', 'b', 'LineWidth', 1.5);

peak_local_dir = [r_plat * cos(phi_azimuth); r_plat * sin(phi_azimuth); 0];
peak_global = R_tilt * peak_local_dir + T_tilt;
center_global = T_tilt;
quiver3(center_global(1), center_global(2), center_global(3), ...
        peak_global(1)-center_global(1), peak_global(2)-center_global(2), peak_global(3)-center_global(3), ...
        0, 'm', 'LineWidth', 3, 'MaxHeadSize', 0.5);
text(peak_global(1), peak_global(2), peak_global(3)+0.5, sprintf('PEAK (Azimuth: %d°, Tilt: %d°)', azimuth_deg, tilt_deg), ...
     'FontSize', 10, 'FontWeight', 'bold', 'Color', 'm');

xlabel('X (cm)'); ylabel('Y (cm)'); zlabel('Z (cm)');
title(sprintf('Auto-Lift IK | Tilt: %d° (Z-Lift: +%.2f cm)', tilt_deg, Z_optimized - Z_home));
legend('Base Motors', 'Platform Joints', 'Servo Horns (L_{short})', 'Connecting Rods (L_{long})', 'Elbow Joints', 'Top Platform', 'Peak Direction', 'Location', 'northeast');

%% --- IK EVALUATION & FEASIBILITY FUNCTION ---
function [angles_vert_deg, valid] = evaluate_ik(R, T, Base_Points, Platform_Local, base_angles_deg, L_s, L_l, min_limit, max_limit)
    angles_vert_deg = zeros(1, 6);
    valid = true;
    Platform_Global = R * Platform_Local + T;
    
    for i = 1:6
        P = Platform_Global(:, i);
        B = Base_Points(:, i);
        
        face_idx = floor((i-1)/2) + 1;
        face_theta = deg2rad(base_angles_deg(2*face_idx - 1));
        
        is_right_motor = mod(i, 2) == 0;
        side_sign = is_right_motor * 2 - 1;
        
        tx = -sin(face_theta);
        ty = cos(face_theta);
        
        BP = P - B;
        z_rel = BP(3);
        xy_proj = dot(BP, side_sign * [tx; ty; 0]);
        r_rel = sqrt(xy_proj^2 + z_rel^2);
        
        % Check if target is geometrically reachable by the 17.1cm rod
        if r_rel > (L_s + L_l) || r_rel < abs(L_s - L_l)
            valid = false;
            return;
        end
        
        cos_beta = (L_s^2 + r_rel^2 - L_l^2) / (2 * L_s * r_rel);
        cos_beta = max(-1, min(1, cos_beta));
        beta = acos(cos_beta);
        gamma = atan2(z_rel, xy_proj);
        
        theta_swing = gamma - beta;
        theta_vert_deg = 90.0 - rad2deg(theta_swing);
        
        % Check limit switch boundaries
        if theta_vert_deg < min_limit || theta_vert_deg > max_limit
            valid = false;
            return;
        end
        
        angles_vert_deg(i) = theta_vert_deg;
    end
end
